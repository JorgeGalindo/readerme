<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- España radar + briefing with `claude -p` (subscription). The Vercel nightly
     runs at 02:00 UTC; 07:00 does the work and 09:30 only acts if 07:00 found
     no fresh candidates or the Mac was asleep. Install:
       cp ops/com.jorge.readerme-ia.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jorge.readerme-ia.plist -->
<plist version="1.0">
<dict>
	<key>Label</key><string>com.jorge.readerme-ia</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
		<string>/Users/jorge/repos/readerme/.venv/bin/python</string>
		<string>/Users/jorge/repos/readerme/spain_ai.py</string>
	</array>
	<key>WorkingDirectory</key><string>/Users/jorge/repos/readerme</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key><string>/Users/jorge/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StandardOutPath</key><string>/Users/jorge/Library/Logs/readerme-ia.log</string>
	<key>StandardErrorPath</key><string>/Users/jorge/Library/Logs/readerme-ia.log</string>
</dict>
</plist>
